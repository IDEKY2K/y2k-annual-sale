{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/brighton-leeds",
      "destination": "/"
    },
    {
      "source": "/qr/:tag",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/items.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ]
}